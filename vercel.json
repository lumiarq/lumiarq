{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "corepack enable && corepack prepare pnpm@10.32.0 --activate && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:vercel",
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "src/storage/framework/cache/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
