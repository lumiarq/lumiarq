{
  "name": "lumiarq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "pnpm run build:css && pnpm run build:node",
    "build:vercel": "pnpm lumis route:cache && pnpm lumis view:cache && pnpm lumis search:index && pnpm run build:css && pnpm run build:vercel-bundle",
    "build:vercel-bundle": "esbuild bootstrap/vercel.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --packages=external --tsconfig=tsconfig.json",
    "dev": "lumis serve",
    "build:css": "tailwindcss -i src/shared/ui/assets/input.css -o src/shared/ui/assets/style.css --minify",
    "dev:css": "tailwindcss -i src/shared/ui/assets/input.css -o src/shared/ui/assets/style.css --watch",
    "build:node": "esbuild bootstrap/entry.ts --bundle --platform=node --target=node20 --format=esm --outfile=.arc/node/app.js --packages=external --tsconfig=tsconfig.json",
    "build:cloudflare": "esbuild bootstrap/entry.ts --bundle --platform=browser --target=esnext --format=esm --outfile=.arc/cf-worker/worker.js --packages=external --tsconfig=tsconfig.json",
    "build:static": "esbuild bootstrap/entry.ts --bundle --platform=node --target=node20 --format=esm --outfile=.arc/static/app.js --packages=external --tsconfig=tsconfig.json",
    "preview:node": "node --env-file=.env .arc/.server.mjs",
    "preview:static": "node --env-file=.env .arc/.server.mjs",
    "preview:cloudflare": "echo 'Deploy .arc/cf-worker/worker.js to Cloudflare via wrangler'",
    "test": "vitest run --config pkg/vitest.config.ts",
    "test:watch": "vitest --config pkg/vitest.config.ts",
    "test:coverage": "vitest run --config pkg/vitest.config.ts --coverage",
    "lint": "eslint src bootstrap --config pkg/eslint.config.mjs",
    "tc": "tsc --noEmit",
    "prepare": "husky",
    "format": "pnpm run format:bootstrap && pnpm run format:config && pnpm run format:src && pnpm run format:tests",
    "format:bootstrap": "prettier --config pkg/prettier.config.mjs --write \"bootstrap/**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:config": "prettier --config pkg/prettier.config.mjs --write \"src/config/**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:src": "prettier --config pkg/prettier.config.mjs --write \"src/**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:tests": "prettier --config pkg/prettier.config.mjs --write \"src/tests/**/*.{js,jsx,ts,tsx,json,css}\"",
    "format:check": "prettier --config pkg/prettier.config.mjs --check \"bootstrap/**/*.{js,ts,json}\" \"src/config/**/*.{js,ts,json}\" \"src/modules/**/*.{js,ts,tsx,json,css}\" \"src/tests/**/*.{js,ts,tsx,json}\" --ignore-path .prettierignore"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "argon2",
      "vue-demi"
    ],
    "overrides": {
      "@illumiarq/adapters": "1.2.0",
      "@illumiarq/auth": "1.1.5",
      "@illumiarq/build": "1.1.5",
      "@illumiarq/cache": "1.1.5",
      "@illumiarq/context": "1.1.5",
      "@illumiarq/contracts": "1.2.0",
      "@illumiarq/core": "1.1.5",
      "@illumiarq/database": "1.1.5",
      "@illumiarq/filesystem": "0.1.1",
      "@illumiarq/http": "1.1.5",
      "@illumiarq/key-value-storage": "0.1.1",
      "@illumiarq/lumis": "1.3.2",
      "@illumiarq/migrations": "1.1.5",
      "@illumiarq/modules": "1.1.5",
      "@illumiarq/query": "1.1.5",
      "@illumiarq/runtime": "1.2.0",
      "@illumiarq/security": "1.1.5",
      "@illumiarq/testing": "1.2.0",
      "@illumiarq/veil": "1.0.6",
      "@lumiarq/framework": "1.0.6",
      "@lumiarq/lumis": "1.2.12",
      "@lumiarq/agent": "1.1.1"
    }
  },
  "dependencies": {
    "@illumiarq/adapters": "^1.2.0",
    "@illumiarq/http": "^1.1.5",
    "@illumiarq/runtime": "^1.2.0",
    "@lumiarq/framework": "^1.0.6",
    "@trazze/ignite": "^0.1.0",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@illumiarq/lumis": "^1.3.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@lumiarq/eslint-plugin": "^1.0.0",
    "@lumiarq/prettier-plugin-veil": "^1.0.0",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.19.17",
    "@vitest/coverage-v8": "^1.4.0",
    "esbuild": "^0.25.0",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "tailwindcss": "4.2.2",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0",
    "zod": "^3.24.1"
  }
}
